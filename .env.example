# DigiSangam runtime configuration
APP_ENV=production
APP_URL=https://events.example.com

# Credential signing
DIGISANGAM_CREDENTIAL_SECRET=replace-with-a-long-random-secret

# Payment: manual | razorpay
DIGISANGAM_PAYMENT_PROVIDER=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email: log | mail | smtp
DIGISANGAM_EMAIL_PROVIDER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=DigiSangam
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=

# WhatsApp: log | meta
DIGISANGAM_WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Set to the Graph API version approved for your Meta app, e.g. vXX.X.
# Leave blank to use the app/default Graph routing.
WHATSAPP_GRAPH_VERSION=

# Phase 3 intelligence service (optional; PHP fallback remains available)
DIGISANGAM_INTELLIGENCE_URL=http://127.0.0.1:8100
DIGISANGAM_INTELLIGENCE_TOKEN=replace-with-a-long-random-internal-token
