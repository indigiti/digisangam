# DigiSangam runtime configuration
APP_ENV=production
APP_URL=https://events.example.com/digisangam

# Credential signing
DIGISANGAM_CREDENTIAL_SECRET=replace-with-a-long-random-secret

# Payment: manual | razorpay
DIGISANGAM_PAYMENT_PROVIDER=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email: log | mail | smtp
DIGISANGAM_EMAIL_PROVIDER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=DigiSangam
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=

# WhatsApp: log | meta
DIGISANGAM_WHATSAPP_PROVIDER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Set to the Graph API version approved for your Meta app, e.g. vXX.X.
# Leave blank to use the app/default Graph routing.
WHATSAPP_GRAPH_VERSION=

# Phase 3 intelligence service (optional; PHP fallback remains available)
DIGISANGAM_INTELLIGENCE_URL=http://127.0.0.1:8100
DIGISANGAM_INTELLIGENCE_TOKEN=replace-with-a-long-random-internal-token

# SMS: log | http
# HTTP provider receives JSON: {"to":"...","message":"...","sender":"..."}
DIGISANGAM_SMS_PROVIDER=log
SMS_HTTP_ENDPOINT=
SMS_HTTP_TOKEN=
SMS_SENDER=

# Wallet provider handoff
# Configure these to the signed pass/save-link endpoint maintained for your Apple/Google issuer account.
APPLE_WALLET_PASS_BASE_URL=
GOOGLE_WALLET_SAVE_BASE_URL=

# Badge printing: log | raw_tcp
DIGISANGAM_PRINT_PROVIDER=log
PRINTER_HOST=
PRINTER_PORT=9100
